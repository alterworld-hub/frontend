{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "yaml", "path": "deploy/chart/Chart.yaml", "jsonpath": "$.version" },
        { "type": "yaml", "path": "deploy/chart/Chart.yaml", "jsonpath": "$.appVersion" }
      ]
    }
  }
}
